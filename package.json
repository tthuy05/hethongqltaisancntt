{
  "name": "it-asset-management-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stitch-based frontend shell; mock development data only, no backend or database access.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/frontend-build.mjs",
    "dev": "node scripts/frontend-server.mjs --build",
    "start": "node scripts/frontend-server.mjs",
    "check": "node scripts/frontend-check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "tailwindcss": "3.4.19"
  }
}
